# Copy to .env and fill in. Everything here is optional: the app works with no keys at all.

# ---- LLM (any OpenAI-compatible API). Grok is the default provider.
# xAI Grok:   LLM_PROVIDER=xai         key from https://console.x.ai   model e.g. the current grok "fast" model
# Groq (free): LLM_PROVIDER=groq       key from https://console.groq.com  model e.g. openai/gpt-oss-120b
# OpenRouter:  LLM_PROVIDER=openrouter model ending in :free
# Ollama:      LLM_PROVIDER=ollama     no key; model e.g. qwen2.5:7b
LLM_PROVIDER=xai
LLM_API_KEY=
LLM_MODEL=
# LLM_BASE_URL=        # overrides the provider preset

# ---- Tracker: read company replies from Gmail (read-only IMAP).
# Gmail: turn on 2-step verification, then create an App Password at https://myaccount.google.com/apppasswords
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=

# ---- Extra job sources with free keys (skipped when blank)
ADZUNA_APP_ID=          # https://developer.adzuna.com
ADZUNA_APP_KEY=
JOOBLE_API_KEY=         # https://jooble.org/api/about
RAPIDAPI_KEY=           # JSearch on RapidAPI, 200 calls/month free
